# Copy to .env and fill in the two API keys plus the auth secret. Everything
# else works as-is.
#
#   cp .env.example .env
#
# `docker compose up` reads the three secrets below and overrides the URLs with
# in-network addresses, because a container cannot reach another service at
# "localhost". The values here describe the host-side setup, which is what the
# development workflow (`pnpm dev`) uses.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Host port 5433 matches docker-compose.yml, which avoids colliding with a
# native PostgreSQL install already listening on 5432.
DATABASE_URL="postgresql://rag:rag@localhost:5433/rag"

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# Anthropic — grounded answers (claude-opus-5) and query rewriting
# (claude-haiku-4-5). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Voyage AI — embeddings (voyage-4) and reranking (rerank-2.5-lite).
# Free tier covers this corpus many times over. https://dash.voyageai.com
VOYAGE_API_KEY=""

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Corpus
# ---------------------------------------------------------------------------
# Absolute or repo-relative path to the markdown corpus to index.
CORPUS_DIR="./data/corpus"

# ---------------------------------------------------------------------------
# MCP server
# ---------------------------------------------------------------------------
MCP_PORT="8787"
# The OAuth 2.1 resource identifier for the MCP server. Access tokens must carry
# this as their audience. It is the MCP endpoint URL, path included: that is the
# value clients send as RFC 8707 `resource`, and a mismatch means every token is
# minted for an audience this server rejects.
MCP_RESOURCE_URL="http://localhost:8787/mcp"
